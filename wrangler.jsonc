{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uniqlo-fitlog",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // 前端静态文件；/api/* 先交给 Worker 处理
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uniqlo-fitlog",
      // 运行 `npx wrangler d1 create uniqlo-fitlog` 后把输出的 id 填到这里
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // 优衣库站点：瑞典 = se；语言 en 或 sv
    "UQ_REGION": "se",
    "UQ_LANG": "en"
  }

  // APP_TOKEN（访问口令）用 `npx wrangler secret put APP_TOKEN` 设置，不要写在这里
}
