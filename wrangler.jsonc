{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uniqlo-fitlog",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // 前端文件（public/）作为文本/二进制模块打包进 Worker，由 src/static.js 返回
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/public/*.js", "**/*.css", "**/*.webmanifest", "**/*.svg"], "fallthrough": false },
    { "type": "Data", "globs": ["**/*.png"], "fallthrough": false }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uniqlo-fitlog",
      // 用 `npx wrangler d1 create uniqlo-fitlog` 创建
      "database_id": "e0b5ad01-c2ac-4550-94a7-dfe1784c65c5",
      "migrations_dir": "migrations"
    }
  ],

  // 官网图片存档（可选）：运行 `npx wrangler r2 bucket create uniqlo-fitlog-images` 后保留这段；
  // 不想用 R2 就删掉这段，应用照常运行，只是不存档
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "uniqlo-fitlog-images" }
  ],

  "vars": {
    // 优衣库站点：瑞典 = se；语言 en 或 sv
    "UQ_REGION": "se",
    "UQ_LANG": "en",
    // 本站查不到时同时去这些站点查（有的款只在别国官网上架，比如加长款），按顺序取第一个查到的
    "UQ_FALLBACK": "uk/en,us/en,au/en,sg/en,jp/ja",
    // 降价提醒邮件里「管理降价提醒」链接指向的地址
    "APP_URL": "https://uniqlo-fitlog.uniqlo-fitlog.workers.dev"
  },

  // 降价提醒：每小时查一批关注的商品（每次 4 件，按最久没查的轮流）
  "triggers": { "crons": ["17 * * * *"] }

  // APP_TOKEN（访问口令）、RESEND_API_KEY（降价提醒发邮件）用 `npx wrangler secret put` 或控制台设置，不要写在这里
}
